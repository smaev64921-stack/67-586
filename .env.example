PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@luxecanvas.ru
ADMIN_PASSWORD=ChangeMe123!

# ЮKassa (тест → потом боевой). Без ключей оплата не создаётся.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# true = тестовый магазин ЮKassa
YOOKASSA_TEST=true
# Чек 54-ФЗ в запросе на оплату (1 = да). Для теста без кассы можно 0.
YOOKASSA_RECEIPT=1
# НДС в чеке: 1 = не облагается (УСН), 2 = 0%, 4 = 20%, 3 = 10%
YOOKASSA_VAT_CODE=1
# СНО, если в кабинете ЮKassa их несколько: 1 ОСН, 2 УСН доходы, 3 УСН доходы-расход
# YOOKASSA_TAX_SYSTEM=2

# СДЭК API v2 — нужны для реальных ПВЗ в оформлении заказа.
# В личном кабинете СДЭК это Client ID / Account и Client Secret / Secure password.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Алиасы тоже поддерживаются, если в панели удобнее назвать как в кабинете СДЭК:
# CDEK_ACCOUNT=
# CDEK_SECURE_PASSWORD=
# Обычно не менять: https://api.cdek.ru/v2
# CDEK_API_URL=
# По трек-номеру магазин сам спрашивает статус заказа (GET /v2/orders)
# и двигает «В обработке» → «Едет» → «Доставлен». Ключи — из договора СДЭК,
# не из GitHub SDK.

# Telegram / Bothost
# На Bothost токен часто приходит как BOT_TOKEN — оба имени поддерживаются.
TELEGRAM_BOT_TOKEN=
# Chat админов бота (через запятую): пуш «Новый заказ» + кнопки + авто-вход
TELEGRAM_CHAT_ID=8133757512,5740311778,5815094886

# Админы по номеру телефона. Номер приходит от самого Telegram, когда человек
# делится контактом в боте, — вписать чужой в профиле не поможет.
# Кто попал в список, входит обычной кнопкой «Через Telegram» и сразу получает
# права администратора, даже если раньше на сайте не регистрировался.
# Через запятую, формат любой: +7 900 123-45-67, 89007654321
ADMIN_PHONES=
# Кому приходят запросы оператора из «Поддержка» (один чат; остальные админы не получают)
TELEGRAM_SUPPORT_CHAT_ID=8133757512
# Выгрузка/загрузка shop.db через бота — только этот chat id
TELEGRAM_DATA_OWNER_CHAT_ID=8133757512
# Numverify — только проверка номера (НЕ отправляет SMS!)
# https://numverify.com/ — 100 запросов/мес на бесплатном тарифе
NUMVERIFY_API_KEY=
# Telegram Gateway — реальная доставка кода в Telegram
TELEGRAM_GATEWAY_TOKEN=
# SMS.ru — запасной канал SMS (если купите)
SMS_RU_API_ID=
SMS_DEV=0
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
# PUBLIC_URL на Bothost можно не задавать: подставится https://$DOMAIN
# PUBLIC_URL=https://ваш-бот.bothost.tech
# Доп. origins для CORS (через запятую), помимо PUBLIC_URL
# CORS_ORIGINS=https://www.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET нужен ТОЛЬКО для старой схемы с переходом на Google.
# Кнопка на сайте работает по ID-токену: хватает одного GOOGLE_CLIENT_ID,
# подпись проверяется публичными ключами Google (server/google-id-token.js).
# В Google Cloud -> Credentials укажите:
#   Authorized JavaScript origins: https://ваш-домен
#   Authorized redirect URIs:      https://ваш-домен/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# ---- Почта: сброс пароля ----
# Без неё сброс пароля работает только через Telegram-бота.
#
# Вариант A (рекомендуется): Resend — отправка обычным HTTPS-запросом.
# Хостинги часто режут исходящие порты 465/587, и SMTP молча не работает.
# Resend сам подписывает письма DKIM — без подписи почтовики шлют письмо в спам.
#   1. Ключ: resend.com → API Keys
#   2. Домен: resend.com/domains → добавить свой домен и внести показанные
#      DNS-записи (SPF + DKIM). ПОКА ДОМЕН НЕ ПОДТВЕРЖДЁН письма уходят
#      только на почту владельца аккаунта Resend — покупатели их не получат.
#   3. RESEND_FROM — адрес на подтверждённом домене, например noreply@shop.ru
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Куда попадут ответы покупателей на письмо (не обязательно)
MAIL_REPLY_TO=

# Вариант B: обычный SMTP. Используется, только если RESEND_API_KEY пуст.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Примерка / OpenAI — ТОЛЬКО на сервере, никогда во фронте
# Вариант A: свой эндпоинт примерки
TRYON_API_URL=
TRYON_API_KEY=
# Вариант B: OpenAI Images (если нет TRYON_API_URL)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536

# Скрытые ошибки сайта -> в Telegram. Один чат, не все админы.
# Пусто = берётся TELEGRAM_DATA_OWNER_CHAT_ID.
TELEGRAM_ERROR_CHAT_ID=
# 0 — не слать в Telegram, только писать в data/errors.log
ERRORS_TO_TELEGRAM=1
# 0 — не перехватывать console.error (останутся падения и ошибки 500)
ERRORS_HOOK_CONSOLE=1
